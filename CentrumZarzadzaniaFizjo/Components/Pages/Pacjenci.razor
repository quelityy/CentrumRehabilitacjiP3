@page "/pacjenci"
@rendermode InteractiveServer
@using CentrumZarzadzaniaFizjo.Models
@using CentrumZarzadzaniaFizjo.Services
@inject FizjoService FizjoService

<h3>Baza pacjentów</h3>

<input placeholder="Szukaj po imieniu lub nazwisku..." @bind="szukanaFraza" @bind:event="oninput" />

@if (komunikat != "")
{
    <div class="alert alert-danger">@komunikat</div>
}

<div>
    <input placeholder="Imię" @bind="nowyPacjent.Imie" />
    <input placeholder="Nazwisko" @bind="nowyPacjent.Nazwisko" />
    <input placeholder="Telefon" @bind="nowyPacjent.Telefon" />
    <input placeholder="E-mail" @bind="nowyPacjent.Email" />
    <button @onclick="DodajPacjenta">Dodaj</button>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Imię</th>
            <th>Nazwisko</th>
            <th>Telefon</th>
            <th>E-mail</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pacjent in FizjoService.WyszukajPacjentow(szukanaFraza))
        {
            <tr>
                <td>@pacjent.Id</td>
                <td>@pacjent.Imie</td>
                <td>@pacjent.Nazwisko</td>
                <td>@pacjent.Telefon</td>
                <td>@pacjent.Email</td>
                <td><button @onclick="() => UsunPacjenta(pacjent.Id)">Usuń</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Pacjent nowyPacjent = new Pacjent();
    private string komunikat = "";
    private string szukanaFraza = "";

    private void DodajPacjenta()
    {
        // imie i nazwisko nie moga byc puste
        if (string.IsNullOrWhiteSpace(nowyPacjent.Imie) || string.IsNullOrWhiteSpace(nowyPacjent.Nazwisko))
        {
            komunikat = "Imię i nazwisko są wymagane!";
            return;
        }

        FizjoService.DodajPacjenta(nowyPacjent);

        // czyscimy formularz
        nowyPacjent = new Pacjent();
        komunikat = "";
    }

    private void UsunPacjenta(int id)
    {
        FizjoService.UsunPacjenta(id);
    }
}